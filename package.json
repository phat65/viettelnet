{
  "name": "viettel-sale-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:migration:create": "payload migrate:create",
    "docker:setup": "node scripts/setup-docker.mjs",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "deploy:check": "node scripts/check-deploy.mjs",
    "test:bootstrap": "node scripts/test-admin-bootstrap.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "graphql": "^16.11.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sass": "^1.89.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "@payloadcms/next>sass": "$sass",
      "monaco-editor>dompurify": "3.4.16"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
