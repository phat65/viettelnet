DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viettel_sale_web
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Run pnpm docker:setup to generate secrets and set the local database URL.
POSTGRES_USER=viettel
POSTGRES_DB=viettel_sale_web
POSTGRES_PASSWORD=replace-with-a-random-uri-safe-password
POSTGRES_PORT=5432
APP_PORT=3000
# Docker always uses migrations. Keep local code on the same schema workflow.
PAYLOAD_DB_PUSH=false
# Required for the first migration on an empty database. No default admin credentials.
# Use a unique password of 16–128 characters. Only the migrate container receives it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
